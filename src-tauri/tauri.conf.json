{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zalo Ultra Native",
  "version": "1.0.2",
  "identifier": "com.xomno01.zaloultranative",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zalo Ultra Native",
        "width": 540,
        "height": 640,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
